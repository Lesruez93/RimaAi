# RimaAI backend configuration. Copy to `.env` and fill in as needed.
# NEVER commit a real .env with secrets.

# --- General ---
ENVIRONMENT=dev
DEBUG=true

# --- Database ---
# Local demo (default): SQLite, zero setup.
DATABASE_URL=sqlite:///./rimaai.db
# Supabase (project qswqdvokmlwkviheimso, eu-west-1) — use the pooled
# connection string from Supabase > Project Settings > Database > Connection
# string > Transaction pooler, with your DB password filled in:
# DATABASE_URL=postgresql+psycopg://postgres.qswqdvokmlwkviheimso:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- Messaging transport: console | twilio ---
MESSAGING_TRANSPORT=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1XXXXXXXXXX
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Triage backend: rule | llm ---
TRIAGE_BACKEND=rule
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Optional real model weights for the /scan fallback ---
# Leave unset to use the deterministic placeholder classifier (default demo).
# Set to a quantized .tflite produced by ml/train_crop_model.py, and install a
# TFLite runtime + Pillow/numpy, to serve real predictions server-side.
# CROP_MODEL_PATH=../app/assets/models/crop_disease_mobilenetv3_int8.tflite
# LIVESTOCK_MODEL_PATH=
# MODEL_LABELS_PATH=../app/assets/models/labels.txt

# --- Outbreak risk aggregation (plain rules, not AI) ---
OUTBREAK_HIGH_RISK_THRESHOLD=6.0
OUTBREAK_MODERATE_RISK_THRESHOLD=3.0
OUTBREAK_RECENCY_WINDOW_DAYS=14

# --- CORS (comma-separated) ---
CORS_ORIGINS=*
